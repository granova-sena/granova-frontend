# API del backend
VITE_API_URL=http://localhost:3000
VITE_FRONTEND_URL=http://localhost:5173

# Llave PÚBLICA de Wompi (modo TEST/sandbox) para tokenizar tarjetas en el navegador.
# Es segura para el cliente. La obtienes en el dashboard sandbox de Wompi.
VITE_WOMPI_PUBLIC_KEY=

# ── Cloudflare Turnstile (anti-bot en el registro) ──────────────
# La Site Key (PÚBLICA) es segura de exponer. La obtienes en
# Dash Cloudflare → Turnstile → Manage Widgets → Create Widget.
# Pega la Site Key en src/pages/Register.jsx y src/pages/RegistroEmpresa.jsx
# (las constantes TURNSTILE_SITE_KEY de cada archivo).
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA1234567890abcd
