# API del backend
VITE_API_URL=http://localhost:3000
VITE_FRONTEND_URL=http://localhost:5173

# Llave PÚBLICA de Wompi (modo TEST/sandbox) para tokenizar tarjetas en el navegador.
# Es segura para el cliente. La obtienes en el dashboard sandbox de Wompi.
VITE_WOMPI_PUBLIC_KEY=

# Site Key de Cloudflare Turnstile. Necesita el prefijo VITE_ para que Vite la
# exponga al navegador. La obtienes en Turnstile -> Manage Widgets.
VITE_API_FRONTEND=
